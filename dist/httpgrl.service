# httpgrl as a hardened systemd service.
#
#   install -m 0755 artifacts/linux-x64/httpgrl /usr/local/bin/httpgrl
#   install -d /etc/httpgrl && cp conf/httpgrl.conf conf/mime.types /etc/httpgrl/
#   useradd --system --no-create-home --shell /usr/sbin/nologin httpgrl
#   cp dist/httpgrl.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now httpgrl
#
# Logs are JSON lines in the journal: journalctl -u httpgrl -o cat | jq .
# Reload config and certificates: systemctl reload httpgrl  (a broken config is logged and ignored)

[Unit]
Description=httpgrl web server
Documentation=file:///usr/share/doc/httpgrl/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=httpgrl
Group=httpgrl
ExecStartPre=/usr/local/bin/httpgrl -t -c /etc/httpgrl/httpgrl.conf
ExecStart=/usr/local/bin/httpgrl -c /etc/httpgrl/httpgrl.conf
ExecReload=/usr/local/bin/httpgrl -t -c /etc/httpgrl/httpgrl.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
# worker_shutdown_timeout (default 10s) bounds the graceful stop; leave headroom.
TimeoutStopSec=30
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

# Ports below 1024 without root; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: everything read-only; the server writes nothing. Content and config are readable.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

# Kernel and process surface.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
# Native AOT: no JIT, so no writable+executable memory is ever needed.
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
